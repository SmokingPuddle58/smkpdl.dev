---
import nav from "../data/nav.json";
import "../styles/global.css";
const { id } = Astro.props;
---

<!-- Merged Desktop and Phone navigation -->
<div class="sticky top-0 z-50 navbar flex flex-col lg:flex-row" id={id}>
    <!-- Left Spacer (Desktop only) -->
    <div class="lg:w-1/3 hidden lg:block"></div>
    <!-- Main Navigation -->
    <div class="w-full lg:w-1/3 flex justify-center ">
        <header class="rounded-full m-5 w-full bg-white">
            <nav class="flex flex-wrap items-center justify-around">
                <div class="internal-links">
                    <a href="/">Home</a>
                </div>
                <div class="internal-links">
                    <a href="/blog/1">Blog</a>
                </div>
                <div class="internal-links">
                    <a href="/misc">Misc</a>
                </div>

                <div class="internal-links">
                    <a href="/contact">Contact</a>
                </div>


                <!--
                <a href="/" class="internal-links ">
                    <Icon size="27" name="misc/sun"/>
                </a>
                <div class="internal-links ">
                    <Icon size="27" name="misc/language"/>
                </div>
                -->
            </nav>
        </header>
    </div>
</div>

<style>
    @reference "tailwindcss";
    header {
        @apply shadow-md border-2 border-gray-200
    }

    nav {
        display: flex;
        align-items: center;
        justify-content: space-around;
    }

    nav a {
        padding: 0.5em 0.5em;
        color: var(--black);
        text-decoration: none;
    }
</style>