---
import nav from "../data/nav.json";
import "../styles/global.css";
import {ThemeIcon} from "./ThemeIcon.astro";
const { id, lang } = Astro.props;
---
<div class="sticky top-5 z-5000 flex flex-col items-center px-4 gap-2" id={id}>
    <div class="flex justify-center w-full">
        <div
            class="shadow-md border-2 border-gray-200 w-[80%] lg:max-w-[29%] bg-white rounded-lg h-15 flex items-center justify-center mr-3 whitespace-nowrap"
        >
            <div class="flex justify-between w-full px-6">
                {
                    nav.slice(0, 3).map((item) => (
                        <div class="flex flex-row">
                            <div class="flex-row mr-2 hidden md:flex">
                                <img src=`../src/assets/icons/${item.icon}.svg` />
                            </div>
                            <a class="flex" href={item.path}>
                                {item[`label_${lang}` as keyof typeof item]}
                            </a>
                        </div>
                    ))
                }
            </div>
        </div>

        <button
            id="menu-toggle"
            aria-expanded="false"
            aria-controls="ext-menu"
            class="shadow-md border-2 border-gray-200 w-[20%] lg:max-w-[5%] bg-white rounded-lg h-15 flex items-center justify-center cursor-pointer"
        >
            <div class="flex">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="1em"
                    height="1em"
                    viewBox="0 0 1024 1024"
                    id="burger-icon"
                >
                    <path d="M0 0h1024v1024H0z" fill="none"></path>
                    <path
                        id="burger-lines"
                        fill="currentColor"
                        d="M904 160H120c-4.4 0-8 3.6-8 8v64c0 4.4 3.6 8 8 8h784c4.4 0 8-3.6 8-8v-64c0-4.4-3.6-8-8-8m0 624H120c-4.4 0-8 3.6-8 8v64c0 4.4 3.6 8 8 8h784c4.4 0 8-3.6 8-8v-64c0-4.4-3.6-8-8-8m0-312H120c-4.4 0-8 3.6-8 8v64c0 4.4 3.6 8 8 8h784c4.4 0 8-3.6 8-8v-64c0-4.4-3.6-8-8-8"
                    ></path>
                </svg>
            </div>
        </button>
    </div>

    <div
        id="ext-menu"
        class="border-2 border-gray-200 w-full lg:max-w-[calc(34%+0.75rem)] bg-white rounded-lg overflow-hidden shadow-md"
        style="height: 0; opacity: 0;"
    >
        {

        }
            <div class="h-15 flex items-center justify-center whitespace-nowrap">
                <div class="flex justify-between w-full px-6">
                    {
                        nav.slice(0, 4).map((item) => (
                            <div class="flex flex-row">
                                <div class="flex-row mr-2 hidden md:flex">
                                    <img src=`../src/assets/icons/${item.icon}.svg` />
                                </div>
                                <a class="flex" href={item.path}>
                                    {item[`label_${lang}` as keyof typeof item]}
                                </a>
                            </div>
                        ))
                    }
                </div>
            </div>

            <div class="h-15 flex items-center justify-center whitespace-nowrap">
                <div class="flex justify-between w-full px-6">
                            <div class="flex flex-row">
                                <div class="flex-row mr-2 hidden md:flex">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 512 512">
                                    <path d="M0 0h512v512H0z" fill="none" />
                                    <path fill="currentColor" d="m478.33 433.6l-90-218a22 22 0 0 0-40.67 0l-90 218a22 22 0 1 0 40.67 16.79L316.66 406h102.67l18.33 44.39A22 22 0 0 0 458 464a22 22 0 0 0 20.32-30.4ZM334.83 362L368 281.65L401.17 362Zm-66.99-19.08a22 22 0 0 0-4.89-30.7c-.2-.15-15-11.13-36.49-34.73c39.65-53.68 62.11-114.75 71.27-143.49H330a22 22 0 0 0 0-44H214V70a22 22 0 0 0-44 0v20H54a22 22 0 0 0 0 44h197.25c-9.52 26.95-27.05 69.5-53.79 108.36c-31.41-41.68-43.08-68.65-43.17-68.87a22 22 0 0 0-40.58 17c.58 1.38 14.55 34.23 52.86 83.93c.92 1.19 1.83 2.35 2.74 3.51c-39.24 44.35-77.74 71.86-93.85 80.74a22 22 0 1 0 21.07 38.63c2.16-1.18 48.6-26.89 101.63-85.59c22.52 24.08 38 35.44 38.93 36.1a22 22 0 0 0 30.75-4.9Z" />
                                </svg>
                                </div>
                                <span class="flex">
                                    Language
                                </span>
                                <span>
                                </span>
                            </div>
                    
                </div>
            </div>

                        <div class="h-15 flex items-center justify-center whitespace-nowrap">
                            <div class="flex justify-between w-full px-6">
                            <div class="flex flex-row">
                                <div class="flex-row mr-2 hidden md:flex">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 20 20">
                                        <path d="M0 0h20v20H0z" fill="none" />
                                        <path fill="currentColor" d="M10 3.5a6.5 6.5 0 1 1 0 13zM10 2a8 8 0 1 0 0 16a8 8 0 0 0 0-16" />
                                    </svg>
                                </div>
                                <span class="flex">
                                    Theme {ThemeIcon}
                                </span>
                                <span>
                                </span>
                            </div>
                    
                </div>
            </div>


    </div>
</div>

<script>
    import { gsap } from "gsap";

    const toggleBtn = document.getElementById("menu-toggle");
    const extMenu = document.getElementById("ext-menu");

    let isOpen = false;
    let isAnimating = false;

    function animateMenu(open: boolean) {
        if (isAnimating) return;
        isAnimating = true;

        const targetHeight = open ? extMenu!.scrollHeight : 0;

        gsap.to(extMenu, {
            height: targetHeight,
            opacity: open ? 1 : 0,
            duration: 0.35,
            ease: open ? "power3.out" : "power2.in",
            onComplete: () => {
                isAnimating = false;
            },
        });
    }

    toggleBtn?.addEventListener("click", () => {
        isOpen = !isOpen;
        toggleBtn.setAttribute("aria-expanded", String(isOpen));
        animateMenu(isOpen);

        window.dispatchEvent(
            new CustomEvent("menu-toggle", { detail: { open: isOpen } })
        );
    });
</script>