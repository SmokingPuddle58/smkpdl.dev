---
import nav from "../data/nav.json";
import "../styles/global.css";
const { id, lang } = Astro.props;
import { getRelativeLocaleUrl } from "astro:i18n";
import allLanguage from "../data/languages.json";
import { ClientRouter } from "astro:transitions";
---

<div class="sticky top-5 z-5000 flex flex-col items-center px-4 gap-2" id={id}>
    <div class="flex justify-center w-full">
        <div
            class="shadow-md border-2 border-gray-200 w-[80%] lg:max-w-[29%] bg-white rounded-lg h-15 flex items-center justify-center mr-3 whitespace-nowrap
                    dark:bg-gray-500 dark:text-gray-100 dark:border-gray-300"
        >
            <div class="flex justify-between w-full px-6">
                {
                    nav.slice(0, 3).map((item) => (
                        <div class="flex flex-row">
                            <div class="flex-row mr-2 hidden md:flex">
                                <img
                                    src={`../../src/assets/icons/${item.icon}.svg`}
                                    alt=""
                                />
                            </div>
                            <a
                                class="flex"
                                href={getRelativeLocaleUrl(lang, item.path)}
                            >
                                {item[`label_${lang}` as keyof typeof item]}
                            </a>
                        </div>
                    ))
                }
            </div>
        </div>

        <details id="menu-details" class="w-[20%] lg:max-w-[5%]">
            <summary
                id="menu-toggle"
                aria-controls="ext-menu"
                aria-label="Toggle menu"
                class="shadow-md border-2 border-gray-200 w-full bg-white rounded-lg h-15 flex items-center justify-center cursor-pointer list-none [&::-webkit-details-marker]:hidden dark:bg-gray-500 dark:text-gray-100 dark:border-gray-300"
            >
                <div class="flex">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="1em"
                        height="1em"
                        viewBox="0 0 1024 1024"
                        id="burger-icon"
                        class="dark:fill-gray-100"
                    >
                        <path d="M0 0h1024v1024H0z" fill="none"></path>
                        <path
                            id="burger-lines"
                            fill="currentColor"
                            d="M904 160H120c-4.4 0-8 3.6-8 8v64c0 4.4 3.6 8 8 8h784c4.4 0 8-3.6 8-8v-64c0-4.4-3.6-8-8-8m0 624H120c-4.4 0-8 3.6-8 8v64c0 4.4 3.6 8 8 8h784c4.4 0 8-3.6 8-8v-64c0-4.4-3.6-8-8-8m0-312H120c-4.4 0-8 3.6-8 8v64c0 4.4 3.6 8 8 8h784c4.4 0 8-3.6 8-8v-64c0-4.4-3.6-8-8-8"
                        ></path>
                    </svg>
                </div>
            </summary>

            <div
                id="ext-menu"
                class="absolute left-4 right-4 mx-auto top-17 border-2 border-gray-200 bg-white dark:bg-gray-500 dark:text-gray-100 dark:border-gray-300 rounded-lg overflow-hidden shadow-md lg:max-w-[calc((100%-2rem)*0.34+0.75rem)]"
            >
                <div
                    class="h-15 flex items-center justify-center whitespace-nowrap"
                >
                    <div class="flex justify-between w-full px-6">
                        {
                            nav.slice(3, 8).map((item) => (
                                <div class="flex flex-row">
                                    <div class="flex-row mr-2 hidden md:flex">
                                        <img
                                            src={`../../src/assets/icons/${item.icon}.svg`}
                                            alt=""
                                        />
                                    </div>
                                    <a
                                        class="flex"
                                        href={getRelativeLocaleUrl(
                                            lang,
                                            item.path,
                                        )}
                                    >
                                        {
                                            item[
                                                `label_${lang}` as keyof typeof item
                                            ]
                                        }
                                    </a>
                                </div>
                            ))
                        }
                    </div>
                </div>

                <div
                    class="h-15 flex items-center justify-center whitespace-nowrap"
                >
                    <div class="flex justify-between w-full px-6 items-center">
                        <div class="flex flex-row items-center">
                            <div class="flex items-center">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="1em"
                                    height="1em"
                                    viewBox="0 0 512 512"
                                    class="mr-2"
                                >
                                    <path d="M0 0h512v512H0z" fill="none"
                                    ></path>
                                    <path
                                        fill="currentColor"
                                        d="m478.33 433.6l-90-218a22 22 0 0 0-40.67 0l-90 218a22 22 0 1 0 40.67 16.79L316.66 406h102.67l18.33 44.39A22 22 0 0 0 458 464a22 22 0 0 0 20.32-30.4ZM334.83 362L368 281.65L401.17 362Zm-66.99-19.08a22 22 0 0 0-4.89-30.7c-.2-.15-15-11.13-36.49-34.73c39.65-53.68 62.11-114.75 71.27-143.49H330a22 22 0 0 0 0-44H214V70a22 22 0 0 0-44 0v20H54a22 22 0 0 0 0 44h197.25c-9.52 26.95-27.05 69.5-53.79 108.36c-31.41-41.68-43.08-68.65-43.17-68.87a22 22 0 0 0-40.58 17c.58 1.38 14.55 34.23 52.86 83.93c.92 1.19 1.83 2.35 2.74 3.51c-39.24 44.35-77.74 71.86-93.85 80.74a22 22 0 1 0 21.07 38.63c2.16-1.18 48.6-26.89 101.63-85.59c22.52 24.08 38 35.44 38.93 36.1a22 22 0 0 0 30.75-4.9Z"
                                    ></path>
                                </svg>
                            </div>
                            {
                                allLanguage.map((item) => (
                                    <div class="h-15 flex items-center justify-center whitespace-nowrap mr-5">
                                        <a
                                            class="flex items-center"
                                            href={getRelativeLocaleUrl(
                                                item.lang_code,
                                            )}
                                        >
                                            {item.lang_name}
                                        </a>
                                    </div>
                                ))
                            }
                        </div>
                    </div>
                </div>

                <div
                    class="h-15 hidden items-center justify-center whitespace-nowrap"
                    id="theme-setting"
                >
                    <div class="flex justify-between w-full px-6">
                        <div class="flex flex-row">
                            <div class="flex-row mr-2 flex items-center">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="20px"
                                    height="20px"
                                    viewBox="0 0 20 20"
                                >
                                    <path d="M0 0h20v20H0z" fill="none"></path>
                                    <path
                                        fill="currentColor"
                                        d="M10 3.5a6.5 6.5 0 1 1 0 13zM10 2a8 8 0 1 0 0 16a8 8 0 0 0 0-16"
                                    ></path>
                                </svg>
                            </div>
                            <button
                                class="flex mr-2 rounded-full w-5 h-5 bg-gray-700 border-2 border-gray-200 cursor-pointer"
                                aria-label="Theme: Dark"
                                onclick="document.documentElement.classList.add('dark'); localStorage.setItem('theme', 'dark')"
                            ></button>
                            <button
                                class="flex mr-2 rounded-full w-5 h-5 bg-gray-200 border-2 border-black cursor-pointer"
                                aria-label="Theme: Light"
                                onclick="document.documentElement.classList.remove('dark'); localStorage.setItem('theme', 'light')"
                            ></button>
                        </div>
                    </div>
                </div>
            </div>
        </details>
    </div>
</div>

<style is:global>
    @media (prefers-reduced-motion: no-preference) {
        html:not(.js) #menu-details::details-content {
            content-visibility: visible;
        }

        html:not(.js) #menu-details #ext-menu {
            opacity: 0;
            visibility: hidden;
            transform: translateY(-8px);
            transition:
                opacity 0.35s cubic-bezier(0.22, 1, 0.36, 1),
                transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
                visibility 0.35s;
        }

        html:not(.js) #menu-details[open] #ext-menu {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }
    }
</style>

<script>
    import { gsap } from "gsap";
        const theme_setting = document.getElementById("theme-setting");
        if (theme_setting) {
            theme_setting.classList.remove("hidden");
            theme_setting.classList.toggle("flex");
        }

        document.documentElement.classList.add("js");

        const details = document.getElementById(
            "menu-details",
        ) as HTMLDetailsElement | null;
        const summary = document.getElementById(
            "menu-toggle",
        ) as HTMLElement | null;
        const extMenu = document.getElementById(
            "ext-menu",
        ) as HTMLElement | null;

        if (details && summary && extMenu) {
            let isOpen = details.hasAttribute("open");
            let isAnimating = false;

            const announce = (open: boolean) => {
                summary.setAttribute("aria-expanded", String(open));
                window.dispatchEvent(
                    new CustomEvent("menu-toggle", { detail: { open } }),
                );
            };

            const animateMenu = (open: boolean) => {
                isAnimating = true;

                if (open) {
                    extMenu.style.height = "0px";
                    extMenu.style.opacity = "0";
                    details.open = true;

                    gsap.to(extMenu, {
                        height: extMenu.scrollHeight,
                        opacity: 1,
                        duration: 0.35,
                        ease: "power3.out",
                        onComplete: () => {
                            extMenu.style.height = "";
                            extMenu.style.opacity = "";
                            isAnimating = false;
                        },
                    });
                } else {
                    gsap.to(extMenu, {
                        height: 0,
                        opacity: 0,
                        duration: 0.35,
                        ease: "power2.in",
                        onComplete: () => {
                            details.open = false;
                            extMenu.style.height = "";
                            extMenu.style.opacity = "";
                            isAnimating = false;
                        },
                    });
                }
            };

            summary.addEventListener("click", (event) => {
                event.preventDefault();
                if (isAnimating) return;

                isOpen = !isOpen;
                announce(isOpen);
                animateMenu(isOpen);
            });

            details.addEventListener("keydown", (event) => {
                if (
                    (event as KeyboardEvent).key === "Escape" &&
                    isOpen &&
                    !isAnimating
                ) {
                    isOpen = false;
                    announce(false);
                    animateMenu(false);
                    summary.focus();
                }
            });

            summary.setAttribute("aria-expanded", String(isOpen));
        }
</script>

