---
import nav from "../data/nav.json";
import "../styles/global.css";
const { id } = Astro.props;
---

<div class="sticky top-5 z-5000 flex justify-center px-4" id={id}>
    <div
        class="shadow-md border-2 border-gray-200 w-[80%] lg:max-w-[29%] bg-white rounded-lg h-15 flex items-center justify-center mr-3"
    >
        <div class="flex justify-between w-full px-6">
            <div class="flex">主頁</div>
            <div class="flex">部落格</div>
            <div class="flex">聯繫我</div>
        </div>
    </div>
    <div
        class="shadow-md border-2 border-gray-200 w-[20%] lg:max-w-[5%] bg-white rounded-lg h-15 flex items-center justify-center"
    >
        <div class="flex">
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="1em"
                height="1em"
                viewBox="0 0 1024 1024"
            >
                <path d="M0 0h1024v1024H0z" fill="none"></path>
                <path
                    fill="currentColor"
                    d="M904 160H120c-4.4 0-8 3.6-8 8v64c0 4.4 3.6 8 8 8h784c4.4 0 8-3.6 8-8v-64c0-4.4-3.6-8-8-8m0 624H120c-4.4 0-8 3.6-8 8v64c0 4.4 3.6 8 8 8h784c4.4 0 8-3.6 8-8v-64c0-4.4-3.6-8-8-8m0-312H120c-4.4 0-8 3.6-8 8v64c0 4.4 3.6 8 8 8h784c4.4 0 8-3.6 8-8v-64c0-4.4-3.6-8-8-8"
                ></path>
            </svg>
        </div>
    </div>
</div>
