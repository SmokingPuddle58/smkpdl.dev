---
const { title, rotation, description } = Astro.props;
---

<a
    class="grid grid-cols-[1fr_auto] rounded-lg border-2 border-gray-200 p-5 mb-2 mt-3 bg-white w-full"
    style={`transform: rotate(${rotation}deg);`}
    href="/projects"
>
    <div class="flex flex-col">
        <p class="text-lg">{title}</p>
        <p class="text-sm text-gray-600 place-items-end">{description}</p>
    </div>

    <div>
        <svg
            xmlns="http://www.w3.org/2000/svg"
            width="2em"
            height="2em"
            viewBox="0 0 24 24"
        >
            <path d="M0 0h24v24H0z" fill="none"></path>
            <path
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 12h16m-7-7l7 7l-7 7"></path>
        </svg>
    </div>
</a>
