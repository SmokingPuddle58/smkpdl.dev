---
import TopBar from "../components/TopBar.astro";
import BottomBar from "../components/BottomBar.astro";
import "../styles/global.css";
import "@fontsource/huninn";
---

<html>
    <head>
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0"
            charset="utf-8"
        />
        <style>
            body {
                background: #f9f8f8;
                font-family: "Huninn";
            }
        </style>
    </head>
    <body class="bg-[#F9F8F8]">
        <div id="smooth-wrapper" class="bg-[#F9F8F8] mb-10">
            <TopBar id="topbar" />
            <div id="smooth-content" class="mt-5">
                <div class="flex">
                    <div class="w-1/30 md:w-1/20 lg:w-3/10"></div>
                    <div class="w-14/15 md:w-9/10 lg:w-2/5 p-5">
                        <slot />
                    </div>
                    <div class="w-1/30 md:w-1/20 lg:w-3/10"></div>
                </div>
            </div>
            <BottomBar text="Hello, World!" id="bottombar" />
        </div>
    </body>
</html>

<script>
    import { gsap } from "gsap";
    import { Draggable } from "gsap/Draggable";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(Draggable, ScrollTrigger);

    const showHeader = gsap.quickTo("#topbar", "y", {
        duration: 0.3,
        ease: "power2.out",
    });
    ScrollTrigger.create({
        trigger: "#smooth-wrapper",
        start: "300 top",
        onUpdate: (self) => {
            if (self.direction === 1) {
                showHeader(-100);
            } else if (self.direction === -1) {
                showHeader(0);
            }
        },
    });
</script>
