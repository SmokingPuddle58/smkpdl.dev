---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BlogCard from "../../../components/BlogCard.astro";
---


<BaseLayout>

<div class="group rounded-lg border-2 border-gray-200 p-5 w-full bg-white dark:bg-slate-700 dark:text-gray-100 transition-colors shadow-md mb-3">
  <label class="flex w-full items-center justify-between font-medium cursor-pointer select-none">
    <input type="checkbox" class="sr-only" />
    <span class="text-xl">過濾</span>
    <span class="transition-transform duration-300 group-has-checked:rotate-180">▼</span>
  </label>

  <div class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-in-out group-has-checked:grid-rows-[1fr]">
    <div class="overflow-hidden">
        <div>分類</div>
        <div>標籤</div>

    </div>
  </div>
</div>
    <div class="flex flex-row items-center w-full dark:text-gray-100 transition-colors text-left">
        
        <div
            class="rounded-lg border-2 border-gray-200 p-5 w-full bg-white dark:bg-slate-700 dark:text-gray-100 transition-colors flex flex-row items-center shadow-md"
        >
            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
                <path d="M0 0h24v24H0z" fill="none"></path>
                <path
                    fill="none"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-width="2"
                    d="m21 21l-4.486-4.494M19 10.5a8.5 8.5 0 1 1-17 0a8.5 8.5 0 0 1 17 0Z"
                ></path>
            </svg>

            <input type="text" class="flex-1 ml-2 p-0 border-none bg-transparent outline-none text-base leading-none" placeholder="輸入關鍵詞"/>
        </div>
    </div>
    <BlogCard></BlogCard>
    <BlogCard></BlogCard>
    <BlogCard></BlogCard>

</BaseLayout>
