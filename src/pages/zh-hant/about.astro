---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SimpleCard from "../../components/SimpleCard.astro";
import IndexLinkCard from "../../components/IndexLinkCard.astro";
import card_info from "../../data/card_info.json";
import { Image } from "astro:assets";
import avatar from "../../assets/author_images/avatar.webp";
---

<BaseLayout>
    <div
        data-home-lang="zh"
        class="flex flex-col items-center w-full dark:text-gray-100 transition-colors"
    >
        <div
            class="flex items-center justify-center gap-1 flex-wrap lg:text-xl md:text-lg w-full text-center dark:text-gray-100 transition-colors"
        >
            Hi！ 我是SmokingPuddle。小弟是香港科技大學數學系的畢業生。

        </div>
        <div class="mt-5 flex flex-horizontal gap-2 flex-wrap container">
        </div>
        <div
            class="rounded-lg border-2 border-gray-200 p-5 w-full m-5 bg-white dark:bg-gray-500 dark:text-gray-100 transition-colors"
        >
            <div class="text-2xl" id="title">資訊</div>
            <span id="description" class="lg:text-xl md:text-lg"> </span>
            <div>
                <button
                    class="bg-blue-500 w-20 mt-3 rounded-full text-white border-3 border-white"
                    id="restore"
                    >重設
                </button>
            </div>
        </div>
    </div>
</BaseLayout>

<style>
    html {
        font-family: var(--font-huninn);
    }
</style>

