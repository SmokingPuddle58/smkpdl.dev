---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SimpleCard from "../../components/SimpleCard.astro";
import IndexLinkCard from "../../components/IndexLinkCard.astro";
import card_info from "../../data/card_info.json";
import { Image } from "astro:assets";
import avatar from "../../assets/author_images/avatar.webp";

const drawingUrls = import.meta.glob("../../assets/simple_drawing/*.svg", {
    eager: true,
    query: "?url",
    import: "default",
}) as Record<string, string>;
function getDrawingUrl(id: string) {
    const key = `../../assets/simple_drawing/${id}.svg`;
    return drawingUrls[key] ?? `/simple_drawing/${id}.svg`;
}
---

<BaseLayout>
    <div
        data-home-lang="zh"
        class="flex flex-col items-center w-full dark:text-gray-100 transition-colors"
    >
        <div
            class="flex items-center justify-center gap-1 flex-wrap lg:text-xl md:text-lg w-full text-center dark:text-gray-100 transition-colors"
        >
            Hi！ 我是
            <Image
                src={avatar}
                alt="Author's Avatar"
                class="rounded-full w-10 border-3 border-blue-300 hover:border-amber-300 ml-1 transition-colors duration-300"
                loading="eager"
            />
            <span class="">SmokingPuddle58。 我是 </span>
        </div>
        <div class="mt-5 flex flex-horizontal gap-2 flex-wrap container">
            {
                card_info.map((card) => (
                    <SimpleCard
                        img={getDrawingUrl(card.id)}
                        rotate={card.rotate}
                        Id={card.id}
                    />
                ))
            }
        </div>
        <div
            class="rounded-lg border-2 border-gray-200 p-5 w-full m-5 bg-white dark:bg-slate-700 dark:text-gray-100 transition-colors"
        >
            <div class="text-2xl" id="title">資訊</div>
            <span id="description" class="lg:text-xl md:text-lg"> </span>
            <noscript>
                <p>
                    我是一隻貓，Coder，科大人及maimaiDX玩家。若想得到更佳的體驗，請考慮開啟JavaScript。:D
                </p>
            </noscript>
            <div>
                <button
                    class="bg-blue-500 w-20 mt-3 rounded-full text-white border-3 border-white"
                    id="restore"
                    >重設
                </button>
            </div>
        </div>
    </div>

    <div class="md:grid md:grid-cols-2 md:gap-4 mt-2">
        <IndexLinkCard
            title="關於我"
            rotation={-5}
            description="了解更多關於我的資訊！"
            link="/zh-hant/about"
        />
        <IndexLinkCard
            title="Colophon"
            rotation={-5}
            description="關於這頁面的資訊！"
            link="/zh-hant/colophon"
        />
        <IndexLinkCard
            title="Webrings"
            rotation={-5}
            description="自Webring而來? 於此繼續行程！"
            link="/zh-hant/webring"
        />
        <IndexLinkCard
            title="部落格"
            rotation={-5}
            description="小弟最新的文章！"
            link="/zh-hant/blog"
        />
    </div>
</BaseLayout>

<style>
    html {
        font-family: var(--font-huninn);
    }
</style>

<script>
    import { gsap } from "gsap";
    import { Draggable } from "gsap/Draggable";
    import { InertiaPlugin } from "gsap/InertiaPlugin";
    import card_info from "../../data/card_info.json";

    gsap.registerPlugin(Draggable, InertiaPlugin);

    let draggables: Draggable[] = [];

    document.addEventListener("astro:page-load", () => {
        // Only run when the Chinese home page is the current page
        // if (!document.querySelector('[data-home-lang="zh"]')) return;

        const ids = card_info.map((item) => item.id);

        const titleElement = document.getElementById("title");
        const descriptionElement = document.getElementById("description");
        if (titleElement && descriptionElement) {
            titleElement.textContent = "資訊";
            descriptionElement.textContent =
                "請點擊、拖動或聚焦正方形圖形以查看更多資訊。";
        }

        function updateInfoPanel(cardId: string) {
            const card = card_info.find((item) => item.id === cardId);
            if (card && titleElement && descriptionElement) {
                titleElement.textContent = card.title_zh;
                descriptionElement.textContent = card.description_zh;
                descriptionElement.setAttribute("aria-live", "polite");
            }
        }

        for (const elem of ids) {
            const element = document.getElementById(elem);
            if (!element) continue;

            const card = card_info.find((item) => item.id === elem);
            if (card) {
                element.setAttribute(
                    "aria-label",
                    `View details for ${card.title_zh}. Draggable element.`,
                );
            }

            draggables.push(
                ...Draggable.create(`#${elem}`, {
                    type: "x,y",
                    bounds: ".container",
                    inertia: true,
                    dragClickables: true,
                    onClick: function () {
                        updateInfoPanel(this.target.id);
                    },
                    onDrag: function () {
                        updateInfoPanel(this.target.id);
                    },
                }),
            );

            element.addEventListener("keydown", (event) => {
                if (event.key === "Enter" || event.key === " ") {
                    event.preventDefault();
                    updateInfoPanel(elem);
                    element.focus();
                }
            });
        }

        const button = document.querySelector("#restore");
        if (button) {
            button.addEventListener("click", () => {
                for (const elem of ids) {
                    const element = document.getElementById(elem);
                    if (element) {
                        gsap.to(element, {
                            x: 0,
                            y: 0,
                            duration: 0.5,
                            ease: "power2.out",
                        });
                    }
                }
                if (titleElement && descriptionElement) {
                    titleElement.textContent = "資訊";
                    descriptionElement.textContent =
                        "請點擊、拖動或聚焦正方形圖形以查看更多資訊。";
                    descriptionElement.removeAttribute("aria-live");
                }
            });
        }
    });

    document.addEventListener("astro:before-swap", () => {
        draggables.forEach((d) => d.kill());
        draggables = [];
    });
</script>
