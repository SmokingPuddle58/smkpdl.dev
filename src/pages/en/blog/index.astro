---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout>
    <div
        class="flex flex-row items-center w-full dark:text-gray-100 transition-colors text-left"
    >
        <div
            class="shadow-md rounded-lg border-2 border-gray-200 p-5 w-full  bg-white dark:bg-slate-700 dark:text-gray-100 transition-colors flex flex-row items-center"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="1em"
                height="1em"
                viewBox="0 0 24 24"
            >
                <path d="M0 0h24v24H0z" fill="none"></path>
                <path
                    fill="none"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-width="2"
                    d="m21 21l-4.486-4.494M19 10.5a8.5 8.5 0 1 1-17 0a8.5 8.5 0 0 1 17 0Z"
                ></path>
            </svg>

            <input
                type="text"
                class="flex-1 ml-2 p-0 border-none bg-transparent outline-none text-base leading-none"
            />
        </div>
    </div>
</BaseLayout>