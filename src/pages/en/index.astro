<style>
    html {
        font-family: var(--font-huninn);
    }
</style>

<script>
    import { gsap } from "gsap";
    import { Draggable } from "gsap/Draggable";
    import { InertiaPlugin } from "gsap/InertiaPlugin";
    import card_info from "../../data/card_info.json";

    gsap.registerPlugin(Draggable, InertiaPlugin);

    const ids = card_info.map((item) => item.id);

    const titleElement = document.getElementById("title");
    const descriptionElement = document.getElementById("description");
    if (titleElement && descriptionElement) {
        titleElement.textContent = "Info";
        descriptionElement.textContent =
            "Click / Drag on a square to see more information.";
    }

    for (const elem of ids) {
        Draggable.create(`#${elem}`, {
            type: "x,y",
            bounds: ".container",
            inertia: true,
            dragClickables: true,
            onClick: function () {
                const card = card_info.find(
                    (item) => item.id === this.target.id,
                );
                if (card) {
                    const titleElement = document.getElementById("title");
                    const descriptionElement =
                        document.getElementById("description");
                    if (titleElement && descriptionElement) {
                        titleElement.textContent = card.title_en;
                        descriptionElement.textContent = card.description_en;
                    }
                }
            },
            onDrag: function () {
                const card = card_info.find(
                    (item) => item.id === this.target.id,
                );
                if (card) {
                    const titleElement = document.getElementById("title");
                    const descriptionElement =
                        document.getElementById("description");
                    if (titleElement && descriptionElement) {
                        titleElement.textContent = card.title_en;
                        descriptionElement.textContent = card.description_en;
                    }
                }
            },
        });
    }

    const button = document.querySelector("#restore");
    button!.addEventListener("click", () => {
        for (const elem of ids) {
            const element = document.getElementById(elem);
            if (element) {
                gsap.to(element, {
                    x: 0,
                    y: 0,
                    duration: 0.5,
                    ease: "power2.out",
                });
            }
        }
        const titleElement = document.getElementById("title");
        const descriptionElement = document.getElementById("description");
        if (titleElement && descriptionElement) {
            titleElement.textContent = "Info";
            descriptionElement.textContent =
                "Click / Drag on a square to see more information.";
        }
    });
</script>
